{
  "name": "codex-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source orchestrator bus for Codex workers with limit-aware scheduling, deterministic task state machine, and controllable auth-profile switching.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "contract-openapi": "node scripts/validate-openapi.mjs",
    "contract-routes": "node scripts/validate-route-coverage.mjs",
    "contract-events": "node scripts/validate-events.mjs",
    "contract-prisma": "node scripts/validate-prisma.mjs",
    "contracts:check": "npm run contract-openapi && npm run contract-routes && npm run contract-events && npm run contract-prisma",
    "logs:check": "node scripts/logs-check.mjs",
    "limits:check": "python scripts/limits-check.py",
    "mcp:serve": "tsx src/mcp/index.ts",
    "smoke:local": "node scripts/smoke-local.mjs",
    "ci:checks": "npm run lint && npm run typecheck && npm run contracts:check",
    "postinstall": "npm run prisma:generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.917.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^9.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^6.18.0",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.2",
    "jszip": "^3.10.1",
    "proxy-agent": "^6.5.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.8.1",
    "@types/supertest": "^6.0.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "prisma": "^6.18.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^3.2.4"
  }
}
