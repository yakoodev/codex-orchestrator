{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-orchestrator.dev/schemas/module-config.schema.json",
  "title": "CustomModuleConfig",
  "type": "object",
  "properties": {
    "module_key": {
      "type": "string",
      "const": "switch_chatgpt_auth_on_limit"
    },
    "is_enabled": {
      "type": "boolean"
    },
    "scope": {
      "type": "string",
      "enum": ["global"]
    },
    "config_json": {
      "type": "object",
      "properties": {
        "eligible_profile_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "weekly_remaining_percent_lt": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 5
        },
        "five_hour_remaining_percent_lt": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 10
        },
        "reset_guard_hours": {
          "type": "number",
          "minimum": 0,
          "default": 3
        },
        "probe_interval_sec": {
          "type": "number",
          "minimum": 5,
          "default": 60
        },
        "switch_cooldown_sec": {
          "type": "number",
          "minimum": 0,
          "default": 120
        }
      },
      "required": [
        "eligible_profile_ids",
        "weekly_remaining_percent_lt",
        "five_hour_remaining_percent_lt",
        "reset_guard_hours",
        "probe_interval_sec",
        "switch_cooldown_sec"
      ],
      "additionalProperties": false
    }
  },
  "required": ["module_key", "is_enabled", "scope", "config_json"],
  "additionalProperties": false
}
