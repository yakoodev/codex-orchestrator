{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-orchestrator.dev/schemas/events/queue.hold.schema.json",
  "title": "QueueHoldEvent",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "type": "string",
          "enum": ["queue.hold_started", "queue.hold_released"]
        },
        "payload": {
          "type": "object",
          "properties": {
            "reason": { "type": "string" },
            "held_count": { "type": "integer", "minimum": 0 }
          },
          "required": ["reason", "held_count"],
          "additionalProperties": true
        }
      },
      "required": ["event_type", "payload"]
    }
  ]
}
