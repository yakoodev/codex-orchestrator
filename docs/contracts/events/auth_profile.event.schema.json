{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-orchestrator.dev/schemas/events/auth_profile.event.schema.json",
  "title": "AuthProfileEvent",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "type": "string",
          "enum": [
            "auth_profile.uploaded",
            "auth_profile.activated",
            "auth_profile.switch.started",
            "auth_profile.switch.retried",
            "auth_profile.switch.failed",
            "auth_profile.switch.completed",
            "auth_profile.switch.skipped"
          ]
        },
        "payload": {
          "type": "object",
          "properties": {
            "profile_id": { "type": ["string", "null"] },
            "from_profile_id": { "type": ["string", "null"] },
            "to_profile_id": { "type": ["string", "null"] },
            "reason": { "type": "string" }
          },
          "required": ["reason"],
          "additionalProperties": true
        }
      },
      "required": ["event_type", "payload"]
    }
  ]
}
