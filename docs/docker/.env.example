# Core service ports
BUS_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# Admin access
ADMIN_TOKEN=change_me_strong_token

# Postgres
POSTGRES_DB=orchestrator
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
DATABASE_URL=postgresql://orchestrator:orchestrator@postgres:5432/orchestrator

# Redis
REDIS_URL=redis://redis:6379

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=orchestrator-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Telegram adapter (optional)
# Use when direct Telegram Bot API access is blocked in your region/network.
# Examples:
# TG_PROXY_URL=socks5://user:pass@proxy.example.com:1080
# TG_PROXY_URL=http://proxy.example.com:3128
# TG_PROXY_URL=https://proxy.example.com:8443
TG_PROXY_URL=

# Module defaults
MODULE_SWITCH_ENABLED=true
SWITCH_WEEKLY_REMAINING_PERCENT_LT=5
SWITCH_FIVE_HOUR_REMAINING_PERCENT_LT=10
SWITCH_RESET_GUARD_HOURS=3
