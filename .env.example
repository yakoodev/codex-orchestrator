# Service
SERVICE_NAME=bus
BUS_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# Admin access
ADMIN_TOKEN=change_me_strong_token

# Postgres
POSTGRES_DB=orchestrator
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
DATABASE_URL=postgresql://orchestrator:orchestrator@postgres:5432/orchestrator

# Redis
REDIS_URL=redis://redis:6379
REDIS_STREAM_KEY=orchestrator.events

# MinIO / S3
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=orchestrator-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Upload
MAX_AUTH_PROFILE_ZIP_MB=25

# Telegram proxy (reserved for future channel implementation)
TG_PROXY_URL=

# Module defaults
MODULE_SWITCH_ENABLED=true
SWITCH_WEEKLY_REMAINING_PERCENT_LT=5
SWITCH_FIVE_HOUR_REMAINING_PERCENT_LT=10
SWITCH_RESET_GUARD_HOURS=3
