# Service
SERVICE_NAME=bus
BUS_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# Admin access
ADMIN_TOKEN=change_me_strong_token

# Postgres
POSTGRES_DB=orchestrator
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
DATABASE_URL=postgresql://orchestrator:orchestrator@postgres:5432/orchestrator

# Redis
REDIS_URL=redis://redis:6379
REDIS_STREAM_KEY=orchestrator.events

# MinIO / S3
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=orchestrator-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
SECRETS_MASTER_KEY=change_me_secrets_master_key
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Upload
MAX_AUTH_PROFILE_JSON_MB=25

# Telegram channel (long polling, optional)
TG_ENABLED=false
TG_BOT_TOKEN=
TG_PROXY_URL=
TG_API_BASE_URL=https://api.telegram.org
TG_ALLOWED_CHAT_IDS=
TG_ALLOWED_USER_IDS=
TG_POLLING_TIMEOUT_SEC=30
TG_BACKOFF_MIN_MS=1000
TG_BACKOFF_MAX_MS=30000
TG_STATE_FILE_PATH=/tmp/orchestrator-telegram/state.json

# Module defaults
MODULE_SWITCH_ENABLED=true
SWITCH_WEEKLY_REMAINING_PERCENT_LT=5
SWITCH_FIVE_HOUR_REMAINING_PERCENT_LT=10
SWITCH_RESET_GUARD_HOURS=3

# Delegation runtime
# auto: try real codex when command+active auth profile are available, otherwise fallback to mock
# codex_exec: strict real codex execution (fails if command/auth profile are unavailable)
# mock: deterministic in-process mock execution
DELEGATION_EXECUTOR_MODE=auto
CODEX_COMMAND=codex
WORKER_RUNTIME_DIR=/tmp/orchestrator-workers
DELEGATION_EXECUTION_TIMEOUT_MS=180000

# MCP bridge (optional, stdio)
MCP_API_BASE_URL=http://localhost:8080
MCP_ADMIN_TOKEN=
MCP_SERVER_NAME=codex-orchestrator-mcp
MCP_SERVER_VERSION=0.1.0
MCP_REQUEST_TIMEOUT_MS=15000
MCP_API_MAX_RETRIES=1
MCP_API_KEY=
MCP_AGENT_PROFILE_ID=
MCP_AGENT_TEMPLATE_ID=
